{
  "name": "react-native-nitro-unzip",
  "version": "0.5.3",
  "description": "High-performance ZIP extraction for React Native, powered by Nitro Modules",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts"
    }
  },
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "nitrogen",
    "react-native-nitro-unzip.podspec",
    "react-native.config.js",
    "nitro.json",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!ios/Tests",
    "!ios/build",
    "!android/build",
    "!android/.cxx",
    "!android/src/test"
  ],
  "scripts": {
    "nitrogen": "nitrogen",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-ci": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "jest",
    "release": "release-it",
    "clean": "rm -rf lib node_modules",
    "prepare": "bob build",
    "prepack": "bob build",
    "prepublishOnly": "bob build"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-modules",
    "unzip",
    "zip",
    "archive",
    "extraction",
    "decompress",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacrowntree/react-native-nitro-unzip.git"
  },
  "author": "Isaac Rowntree",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isaacrowntree/react-native-nitro-unzip/issues"
  },
  "homepage": "https://isaacrowntree.github.io/react-native-nitro-unzip/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.35.9"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native/eslint-config": "^0.75.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/jest": "^29.5.0",
    "babel-jest": "^30.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.35.9",
    "prettier": "^3.0.0",
    "react-native-builder-bob": "^0.35.0",
    "react-native-nitro-modules": "0.35.9",
    "release-it": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "tabWidth": 2,
    "useTabs": false
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "module",
      "typescript"
    ]
  }
}
