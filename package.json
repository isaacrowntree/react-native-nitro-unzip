{
  "name": "react-native-nitro-unzip",
  "version": "0.5.3",
  "description": "High-performance ZIP extraction for React Native, powered by Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "nitrogen",
    "react-native-nitro-unzip.podspec",
    "react-native.config.js",
    "nitro.json",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!ios/Tests",
    "!ios/build",
    "!android/build",
    "!android/.cxx",
    "!android/src/test"
  ],
  "scripts": {
    "nitrogen": "nitrogen",
    "typescript": "tsc --noEmit",
    "lint": "eslint src",
    "lint-ci": "eslint src --max-warnings 0",
    "test": "jest",
    "release": "release-it",
    "clean": "rm -rf lib node_modules",
    "prepare": "bob build",
    "prepack": "bob build",
    "prepublishOnly": "bob build",
    "format": "prettier --write \"{src,example}/**/*.{ts,tsx}\"",
    "format-ci": "prettier --check \"{src,example}/**/*.{ts,tsx}\"",
    "test:android": "cd example/android && ./gradlew :react-native-nitro-unzip:test",
    "test:ios": "swift test",
    "check-exports": "attw --pack .",
    "prebuild:example": "npm --prefix example run prebuild",
    "typescript:example": "tsc --noEmit --project example/tsconfig.json",
    "e2e": "maestro test .maestro",
    "e2e:android": "maestro --device emulator-5554 test .maestro"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-modules",
    "unzip",
    "zip",
    "archive",
    "extraction",
    "decompress",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacrowntree/react-native-nitro-unzip.git"
  },
  "author": "Isaac Rowntree",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isaacrowntree/react-native-nitro-unzip/issues"
  },
  "homepage": "https://isaacrowntree.github.io/react-native-nitro-unzip/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nitrogen": "^0.37.0",
    "prettier": "^3.9.6",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.37.0",
    "release-it": "^21.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "tabWidth": 2,
    "useTabs": false
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  }
}
