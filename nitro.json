{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["unzip"],
  "ios": {
    "iosModuleName": "NitroUnzip"
  },
  "android": {
    "androidNamespace": ["unzip"],
    "androidCxxLibName": "NitroUnzip"
  },
  "autolinking": {
    "Unzip": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridUnzip"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridUnzip"
      }
    }
  },
  "ignorePaths": ["node_modules", "lib", "example"]
}
